# =====================================================
# SPARK.EV City Grid - Environment Configuration
# =====================================================

# NextAuth Authentication
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="spark_ev_super_secret_jwt_key_min_32_chars_2026"
NEXTAUTH_URL="http://localhost:3000"

# HS256 Secret for Cryptographic Signed QR Gate Passes
QR_SECRET="spark_ev_gate_token_hs256_symmetric_key_2026_super_secure"

# Map & Places Provider: "osm" (OpenStreetMap Overpass - Default & Free) or "google" (Google Places API New)
PLACES_PROVIDER="osm"

# Optional: Google Maps API key (Required only if PLACES_PROVIDER="google")
# GOOGLE_MAPS_API_KEY="your-google-places-api-key"

# Hardware Barrier Relay Controller (Optional webhook/serial bridge URL for real parking gates)
# BARRIER_RELAY_URL="http://192.168.1.120:8080/relay/open"

# OCPP Central System WebSocket (Optional bridge for EV charger hardware)
# OCPP_CENTRAL_SYSTEM_URL="wss://ocpp.spark-ev.grid/v16"
